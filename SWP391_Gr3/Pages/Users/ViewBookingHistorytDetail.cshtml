@page "{id:int}"
@model SWP391_Gr3.Pages.Users.ViewBookingHistorytDetailModel

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var detail = Model.OrderDetail;
}

<div class="container bg-white p-4 rounded shadow-sm mt-4">
    <h2 class="mb-4">Chi tiết đơn hàng </h2>

    @if (detail == null)
    {
        <p class="text-danger fw-bold">Không tìm thấy đơn hàng.</p>
    }
    else
    {
        <p><strong>Phim:</strong> @detail.MovieTitle</p>
        <p><strong>Suất chiếu:</strong> @detail.Showtime.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Ghế đã đặt:</strong></p>
     
        <ul>
            @foreach (var t in detail.Tickets)
            {
                <li>
                    Mã vé: @t.TicketCode – Ghế: @t.SeatCode (@t.SeatType) – Giá: @t.Price.ToString("N0") đ
                </li>
            }
        </ul>


        <h4>Combo đã chọn</h4>
        @if (detail.Combos.Any())
        {
            <ul>
                @foreach (var combo in detail.Combos)
                {
                    <li>@combo.ComboName - Số lượng: @combo.Quantity - Giá: @(combo.Price * combo.Quantity) đ</li>
                }
            </ul>
        }
        else
        {
            <p>Không có combo.</p>
        }

        <h4>Sản phẩm đã chọn</h4>
        @if (detail.Products.Any())
        {
            <ul>
                @foreach (var product in detail.Products)
                {
                    <li>@product.ProductName - Số lượng: @product.Quantity - Giá: @(product.Price * product.Quantity) đ</li>
                }
            </ul>
        }
        else
        {
            <p>Không có sản phẩm.</p>
        }

        @if (!detail.Combos.Any() && !detail.Products.Any())
        {
            <p><em>Không có sản phẩm nào trong đơn hàng này.</em></p>
        }
        <p class="mt-3"><strong>Tổng tiền:</strong> @detail.TotalPrice đ</p>
    }
</div>
