@page
@model SWP391_Gr3.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
}


@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="container  bg-white p-4 rounded shadow-sm">
    <h2>Cập nhật hồ sơ</h2>
    <input asp-for="ProfileDto.Id" type="hidden" />

    <div class="form-group">
        <label asp-for="ProfileDto.FullName"></label>
        <input asp-for="ProfileDto.FullName" class="form-control" />
        <span asp-validation-for="ProfileDto.FullName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ProfileDto.Email"></label>
        <input asp-for="ProfileDto.Email" class="form-control" readonly />
        <span asp-validation-for="ProfileDto.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ProfileDto.PhoneNumber"></label>
        <input asp-for="ProfileDto.PhoneNumber" class="form-control" />
        <span asp-validation-for="ProfileDto.PhoneNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ProfileDto.Address"></label>
        <input asp-for="ProfileDto.Address" class="form-control" />
        <span asp-validation-for="ProfileDto.Address" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Lưu thay đổi</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
