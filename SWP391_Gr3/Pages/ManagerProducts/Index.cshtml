@page
@model SWP391_Gr3.Pages.ManagerProducts.IndexModel
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div style="background-color: white; padding: 20px; border-radius: 6px;">
    <h2>Quản lý món ăn / đồ uống</h2>

    <a asp-page="Create" class="btn btn-primary mb-3">+ Thêm món mới</a>

    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="SearchString" value="@Model.SearchString" class="form-control" placeholder="Tìm theo tên...">
            <button type="submit" class="btn btn-outline-primary">Tìm</button>
        </div>
    </form>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Tên</th>
                <th>Size</th>
                <th>Giá (VNĐ)</th>
                <th>Tồn kho</th>
                <th>Loại</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Size</td>
                    <td>@string.Format("{0:N0}", item.Price) ₫</td>
                    <td>@item.Stock</td>
                    <td>@item.ProductCategory?.Name</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="?SearchString=@Model.SearchString&PageNumber=@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
