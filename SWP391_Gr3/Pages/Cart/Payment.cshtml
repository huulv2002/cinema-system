@page
@model SWP391_Gr3.Pages.Cart.PaymentModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-danger text-white rounded-top-4">
            <h3 class="mb-0 text-center">Thanh toán đơn hàng qua VNPAY</h3>
        </div>
        <div class="card-body p-4">

            <div class="mb-3">
                <label class="form-label fw-bold">Mã đơn hàng:</label>
                <input type="text" class="form-control bg-light" value="@Model.OrderId" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Chọn khuyến mãi:</label>
                <select class="form-select" id="promotionSelect">
                    <option value="0" data-value="0">-- Không áp dụng --</option>
                    @foreach (var promo in Model.Promotions)
                    {
                        <option value="@promo.Id" data-value="@promo.Value">
                            @promo.Code - giảm @promo.Value
                        </option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Số tiền cần thanh toán:</label>
                <input type="text" class="form-control-plaintext fs-4 text-danger fw-bold" id="amountDisplay" value="@Model.Amount.ToString("N0") đ" readonly />
                <input type="hidden" id="amount" name="amount" value="@Model.Amount" />
            </div>

            <form method="post" id="paymentForm">
                <input type="hidden" name="orderId" value="@Model.OrderId" />
                <input type="hidden" name="orderInfo" value="@Model.OrderId" />
                <input type="hidden" id="amount" name="amount" value="@Model.Amount" />
                <button type="submit" class="btn btn-danger w-100 py-3 fs-5 rounded-3 mt-3 shadow">
                    <i class="bi bi-credit-card-2-front-fill me-2"></i> Thanh toán qua VNPAY
                </button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('promotionSelect').addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];
            const promoValue = parseFloat(selectedOption.getAttribute('data-value')) || 0;
            const originalAmount = @Model.Amount;
            const discounted = Math.max(0, originalAmount - promoValue);

            document.getElementById('amountDisplay').value = discounted.toLocaleString('vi-VN') + " đ";
            document.getElementById('amount').value = discounted;
        });
    </script>
}
