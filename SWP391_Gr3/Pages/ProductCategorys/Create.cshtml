@page
@model SWP391_Gr3.Pages.ProductCategorys.CreateModel
@{
}

<div class="container bg-white p-4 rounded shadow-sm">
    <h2>Thêm danh mục mới</h2>
<form method="post">
    <div class="mb-3">
        <label asp-for="ProductCategory.Name" class="form-label"></label>
        <input asp-for="ProductCategory.Name" class="form-control" />
        <span asp-validation-for="ProductCategory.Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Lưu</button>
    <a asp-page="Index" class="btn btn-secondary">Hủy</a>
</form>
</div>